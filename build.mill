//| mill-version: 1.1.6
// renovate: datasource=github-releases depName=com-lihaoyi/mill versioning=semver
package build

import mill.*
import javalib.SonatypeCentralPublishModule
import javalib.publish.*
import scalalib.*

object Versions:
  // renovate: datasource=github-releases depName=scala/scala3 versioning=semver
  val scala = "3.8.4"
  val library = "1.0.0"
  // renovate: datasource=maven depName=dev.zio:zio_3 versioning=maven
  val zio = "2.1.26"
  // renovate: datasource=maven depName=dev.zio:zio-json_3 versioning=maven
  val zioJson = "0.9.2"
  // The HOCON reader `GiteaConfig.fromTypesafeConfig` uses, and the type its
  // public signature names. Declared directly rather than inherited from
  // zio-config: a library whose API mentions a type must depend on it.
  // renovate: datasource=maven depName=com.typesafe:config versioning=maven
  val typesafeConfig = "1.4.6"
  // renovate: datasource=maven depName=com.softwaremill.sttp.client4:core_3 versioning=maven
  val sttp = "4.0.25"

trait Gitea4sModule extends ScalaModule:
  def scalaVersion = Versions.scala

  def extraTestMvnDeps = Seq.empty[Dep]

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wsafe-init",
    // Compile against exactly the Java 21 API the project advertises, so a
    // newer local JDK cannot silently let a Java 22+ method into the jars.
    "-release",
    "21",
    "-Wunused:all",
    // The two checks that matter most for an effect library: a discarded ZIO
    // value is an effect that silently never runs, and the compiler is the
    // only thing that can see it.
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Xcheck-macros",
    "-Werror"
  )

  def javacOptions = Seq("--release", "21")

  object test extends ScalaTests:
    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${Versions.zio}",
      mvn"dev.zio::zio-test-sbt:${Versions.zio}"
    ) ++ Gitea4sModule.this.extraTestMvnDeps

    def testFramework = "zio.test.sbt.ZTestFramework"

trait PublishableGitea4sModule extends Gitea4sModule, SonatypeCentralPublishModule:
  def publishVersion = Versions.library

  def pomSettings = PomSettings(
    description = "Scala 3 ZIO client library for Gitea API v1.26.2",
    organization = "io.worxbend",
    url = "https://github.com/worxbend/gitea-scala-client",
    licenses = Seq(
      License(
        id = "Apache-2.0",
        name = "Apache License 2.0",
        url = "https://www.apache.org/licenses/LICENSE-2.0",
        isOsiApproved = true,
        isFsfLibre = true,
        distribution = "repo"
      )
    ),
    versionControl = VersionControl.github("worxbend", "gitea-scala-client"),
    developers = Seq(
      Developer(
        id = "worxbend",
        name = "Worxbend",
        url = "https://github.com/worxbend"
      )
    )
  )

object core extends PublishableGitea4sModule:
  def artifactName = "gitea4s-core"

  def mvnDeps = Seq(
    mvn"dev.zio::zio:${Versions.zio}",
    mvn"dev.zio::zio-streams:${Versions.zio}",
    mvn"dev.zio::zio-json:${Versions.zioJson}"
  )

object client extends PublishableGitea4sModule:
  def artifactName = "gitea4s-client"

  def moduleDeps = Seq(core)

  def extraTestMvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}"
  )

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::core:${Versions.sttp}",
    mvn"com.typesafe:config:${Versions.typesafeConfig}"
  )

object `backend-zio` extends PublishableGitea4sModule:
  def artifactName = "gitea4s-backend-zio"

  def moduleDeps = Seq(client)

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}"
  )

object `backend-okhttp` extends PublishableGitea4sModule:
  def artifactName = "gitea4s-backend-okhttp"

  def moduleDeps = Seq(client)

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::okhttp-backend:${Versions.sttp}"
  )

object examples extends Gitea4sModule:
  def moduleDeps = Seq(`backend-zio`)

  def mainClass = Some("io.worxbend.gitea4s.examples.ShowApiReference")

object it extends Gitea4sModule:
  def moduleDeps = Seq(`backend-zio`)

object compatibility extends Module:
  private val v1ReleaseCommit = "24fda6ec0051258a0cb7866fb3a7db4cf70fa5ed"

  // Mill does set `PWD` to the workspace root, so the previous `sys.env("PWD")`
  // lookup worked — but its `user.dir` fallback resolved to the throwaway
  // `out/mill-daemon/sandbox` directory, which would have silently written the
  // baseline somewhere nobody would ever read it. Ask Mill directly instead.
  private def workspaceRoot: os.Path = mill.api.BuildCtx.workspaceRoot

  // Every module that is actually published needs a baseline. Deriving the list
  // from `publishedModules` rather than repeating the names keeps a new module
  // from being added to the build without also being added to the guard.
  private val publishedModules: Seq[(String, PublishableGitea4sModule)] = Seq(
    "core" -> core,
    "client" -> client,
    "backend-zio" -> `backend-zio`,
    "backend-okhttp" -> `backend-okhttp`
  )

  private def publishedJars = Task.Anon {
    Task.traverse(publishedModules.map(_._2))(_.jar)().map(_.path).zip(publishedModules.map(_._1)).map(_.swap)
  }

  private def publicClassNames(jar: os.Path): Seq[String] =
    os.proc("jar", "tf", jar)
      .call()
      .out
      .text()
      .linesIterator
      .filter(_.startsWith("io/worxbend/gitea4s/"))
      .filter(_.endsWith(".class"))
      .filterNot(_.contains("/internal/"))
      .filterNot(_.contains("$$anon"))
      .map(_.stripSuffix(".class").replace('/', '.'))
      .toSeq
      .sorted

  private def publicClassSignature(jar: os.Path, className: String): String =
    os.proc("javap", "-classpath", jar.toString, "-public", className)
      .call()
      .out
      .text()
      .linesIterator
      .filterNot(_.startsWith("Compiled from "))
      .mkString("\n")
      .trim

  private def snapshotText(moduleName: String, jar: os.Path): String =
    val sections = publicClassNames(jar).map { className =>
      s"## $className\n${publicClassSignature(jar, className)}"
    }

    s"""# Public API snapshot for $moduleName
       |# Generated by ./mill compatibility.writeSnapshot.
       |# Verify with ./mill compatibility.check.
       |
       |${sections.mkString("\n\n")}
       |""".stripMargin

  def generated = Task {
    os.makeDir.all(Task.dest)

    for (moduleName, jar) <- publishedJars() do
      os.write.over(Task.dest / s"$moduleName.txt", snapshotText(moduleName, jar))

    PathRef(Task.dest)
  }

  def writeSnapshot() = Task.Command {
    val baselineDir = workspaceRoot / "api-snapshot"
    os.makeDir.all(baselineDir)

    for generatedFile <- os.list(generated().path) do
      os.write.over(baselineDir / generatedFile.last, os.read.bytes(generatedFile), createFolders = true)
  }

  // The 1.0.0 tag is fixed independently of the refreshable working snapshot.
  // These three classes were Scala-private in 1.0.0 despite javap reporting
  // them as public. Compiler-generated names are not callable API; toString
  // still resolves virtually from a superclass when a local override moves.
  private val v1PrivateClasses = Set(
    "io.worxbend.gitea4s.http.GiteaRequest$StringImpl",
    "io.worxbend.gitea4s.http.GiteaResponseMapper$UserSearchResults",
    "io.worxbend.gitea4s.http.GiteaResponseMapper$UserSearchResults$"
  )

  private def releaseSignatures(snapshot: String): Map[String, Set[String]] =
    snapshot.split("(?m)^## ").iterator.drop(1).map { section =>
      val lines = section.linesIterator.toList
      val className = lines.head.trim
      val members = lines.tail.map(_.trim).filter { member =>
        member.startsWith("public ") && member.endsWith(";") &&
        member != "public java.lang.String toString();" &&
        !member.contains("$$anon") && !member.contains("$$$given_")
      }.toSet
      className -> members
    }.filterNot { case (name, _) => v1PrivateClasses.contains(name) }.toMap

  private def missingReleaseSignatures(released: String, current: String): Seq[String] =
    val currentClasses = releaseSignatures(current)
    releaseSignatures(released).toSeq.sortBy(_._1).flatMap { case (className, members) =>
      currentClasses.get(className) match
        case None => Seq(s"Missing v1.0.0 class: $className")
        case Some(currentMembers) =>
          (members -- currentMembers).toSeq.sorted.map(member => s"Missing v1.0.0 member in $className: $member")
    }

  private def releasedSnapshot(snapshotName: String): String =
    os.proc("git", "-C", workspaceRoot, "show", s"$v1ReleaseCommit:api-snapshot/$snapshotName")
      .call()
      .out.text()

  private def verifyV1Tag(): Unit =
    val tagCommit = os.proc("git", "-C", workspaceRoot, "rev-parse", "--verify", "v1.0.0^{commit}")
      .call(check = false).out.text().trim
    if tagCommit != v1ReleaseCommit then
      throw new Exception("The pinned v1.0.0 tag is missing or moved; fetch the original tag before checking compatibility.")

  def testReleaseGuard() = Task.Command {
    val released = "## example.Public\npublic final class example.Public {\n  public example.Public();\n  public int count();\n}\n"
    val changed = "## example.Public\npublic final class example.Public {\n  public example.Public();\n  public int total();\n}\n"
    val missingClass = "## example.Other\npublic final class example.Other {\n}\n"
    assert(missingReleaseSignatures(released, released).isEmpty)
    assert(missingReleaseSignatures(released, released.replace("  public int count();", "  public int count();\n  public int total();")).isEmpty)
    assert(missingReleaseSignatures(released, changed) == Seq("Missing v1.0.0 member in example.Public: public int count();"))
    assert(missingReleaseSignatures(released, missingClass) == Seq("Missing v1.0.0 class: example.Public"))

    verifyV1Tag()
    val currentClient = os.read(generated().path / "client.txt")
    val v1Client = releasedSnapshot("client.txt")
    val oldApply = "public io.worxbend.gitea4s.http.UserSearchParams apply(scala.Option<java.lang.String>, scala.Option<java.lang.Object>, scala.Option<java.lang.Object>);"
    assert(currentClient.contains(s"  $oldApply\n"))
    val refreshedWithoutOldApply = currentClient.replace(s"  $oldApply\n", "")
    assert(missingReleaseSignatures(v1Client, refreshedWithoutOldApply).contains(
      s"Missing v1.0.0 member in io.worxbend.gitea4s.http.UserSearchParams$$: $oldApply"
    ))
  }

  private def workingSnapshotFailures(baselineDir: os.Path, generatedFiles: Seq[os.Path]): Seq[String] =
    // The comparison below only walks the *generated* files. On its own that
    // means a baseline whose module has been dropped from `publishedModules` is
    // never compared and never reported: the check would pass while a still
    // published artifact went unverified. Require the two sets to match.
    val generatedNames = generatedFiles.map(_.last).toSet
    val baselineNames = if os.exists(baselineDir) then os.list(baselineDir).map(_.last).toSet else Set.empty[String]
    val orphaned = (baselineNames -- generatedNames).toSeq.sorted.map { name =>
      s"Orphaned API snapshot: api-snapshot/$name has no corresponding published module."
    }

    orphaned ++ generatedFiles.flatMap { generatedFile =>
      val expectedFile = baselineDir / generatedFile.last

      if !os.exists(expectedFile) then
        Some(s"Missing API snapshot: ${expectedFile.relativeTo(workspaceRoot)}")
      else if os.read(expectedFile) == os.read(generatedFile) then
        None
      else
        val diff = os.proc("diff", "-u", expectedFile, generatedFile)
          .call(check = false)
          .out
          .text()
        Some(s"API snapshot changed for ${generatedFile.last}:\n$diff")
    }

  private def releaseFailures(generatedFiles: Seq[os.Path]): Seq[String] =
    generatedFiles.flatMap { generatedFile =>
      missingReleaseSignatures(releasedSnapshot(generatedFile.last), os.read(generatedFile))
    }

  def check() = Task.Command {
    verifyV1Tag()
    val generatedFiles = os.list(generated().path)
    val failures = workingSnapshotFailures(workspaceRoot / "api-snapshot", generatedFiles) ++
      releaseFailures(generatedFiles)

    if failures.nonEmpty then
      throw new Exception(
        failures.mkString(
          "Public API compatibility check failed. Refreshing api-snapshot cannot waive a v1.0.0 break.\n\n",
          "\n",
          ""
        )
      )
  }
