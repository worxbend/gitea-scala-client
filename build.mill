//| mill-version: 1.1.6
// renovate: datasource=github-releases depName=com-lihaoyi/mill versioning=semver
package build

import mill.*
import javalib.SonatypeCentralPublishModule
import javalib.publish.*
import scalalib.*

object Versions:
  // renovate: datasource=github-releases depName=scala/scala3 versioning=semver
  val scala = "3.8.4"
  val library = "0.1.0-SNAPSHOT"
  // renovate: datasource=maven depName=dev.zio:zio_3 versioning=maven
  val zio = "2.1.26"
  // renovate: datasource=maven depName=dev.zio:zio-json_3 versioning=maven
  val zioJson = "0.9.2"
  // renovate: datasource=maven depName=dev.zio:zio-config_3 versioning=maven
  val zioConfig = "4.0.7"
  // renovate: datasource=maven depName=com.softwaremill.sttp.client4:core_3 versioning=maven
  val sttp = "4.0.25"

trait Gitea4sModule extends ScalaModule:
  def scalaVersion = Versions.scala

  def extraTestMvnDeps = Seq.empty[Dep]

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wsafe-init"
  )

  def javacOptions = Seq("--release", "21")

  object test extends ScalaTests:
    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${Versions.zio}",
      mvn"dev.zio::zio-test-sbt:${Versions.zio}"
    ) ++ Gitea4sModule.this.extraTestMvnDeps

    def testFramework = "zio.test.sbt.ZTestFramework"

trait PublishableGitea4sModule extends Gitea4sModule, SonatypeCentralPublishModule:
  def publishVersion = Versions.library

  def pomSettings = PomSettings(
    description = "Scala 3 ZIO client library for Gitea API v1.26.2",
    organization = "io.worxbend",
    url = "https://github.com/worxbend/gitea-scala-client",
    licenses = Seq(
      License(
        id = "GPL-2.0-only",
        name = "GNU General Public License v2.0 only",
        url = "https://www.gnu.org/licenses/old-licenses/gpl-2.0-standalone.html",
        isOsiApproved = true,
        isFsfLibre = true,
        distribution = "repo"
      )
    ),
    versionControl = VersionControl.github("worxbend", "gitea-scala-client"),
    developers = Seq(
      Developer(
        id = "worxbend",
        name = "Worxbend",
        url = "https://github.com/worxbend"
      )
    )
  )

object core extends PublishableGitea4sModule:
  def artifactName = "gitea4s-core"

  def mvnDeps = Seq(
    mvn"dev.zio::zio:${Versions.zio}",
    mvn"dev.zio::zio-streams:${Versions.zio}",
    mvn"dev.zio::zio-json:${Versions.zioJson}"
  )

object client extends PublishableGitea4sModule:
  def artifactName = "gitea4s-client"

  def moduleDeps = Seq(core)

  def extraTestMvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}"
  )

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::core:${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::zio-json:${Versions.sttp}",
    mvn"dev.zio::zio-config:${Versions.zioConfig}",
    mvn"dev.zio::zio-config-typesafe:${Versions.zioConfig}"
  )

object `backend-zio` extends PublishableGitea4sModule:
  def artifactName = "gitea4s-backend-zio"

  def moduleDeps = Seq(client)

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}"
  )

object `backend-okhttp` extends PublishableGitea4sModule:
  def artifactName = "gitea4s-backend-okhttp"

  def moduleDeps = Seq(client)

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.client4::zio:${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::okhttp-backend:${Versions.sttp}"
  )

object examples extends Gitea4sModule:
  def moduleDeps = Seq(`backend-zio`)

  def mainClass = Some("io.worxbend.gitea4s.examples.ShowApiReference")

object it extends Gitea4sModule:
  def moduleDeps = Seq(`backend-zio`)
